<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================= -->
    <!-- VISTA LISTA DE NÓMINAS -->
    <!-- ============================= -->
    <record id="view_nomina_list" model="ir.ui.view">
        <field name="name">nomina.nomina.list</field>
        <field name="model">nomina.nomina</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <list string="Nóminas">
                <field name="empleado_id" />
                <field name="mes" />
                <field name="anio" />
                <field name="salario_base" />
                <field name="horas_extra" />
                <field name="total_bruto" />
            </list>
        </field>
    </record>

    <!-- ============================= -->
    <!-- VISTA FORMULARIO DE NÓMINA -->
    <!-- ============================= -->
    <record id="view_nomina_form" model="ir.ui.view">
        <field name="name">nomina.nomina.form</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <form string="Nómina">

                <header>
                    <button name="%(action_generar_nomina_wizard)d"
                        string="Generar nómina"
                        type="action"
                        class="btn-primary" />
                </header>

                <sheet>
                    <group>
                        <field name="empleado_id" />
                        <field name="mes" />
                        <field name="anio" />
                    </group>

                    <group string="Datos económicos">
                        <field name="salario_base" />
                        <field name="horas_extra" />
                        <field name="precio_hora_extra" />
                        <field name="complementos" />
                        <field name="total_bruto" readonly="1" />
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ============================= -->
    <!-- ACCIÓN -->
    <!-- ============================= -->
    <record id="action_nomina" model="ir.actions.act_window">
        <field name="name">Nóminas</field>
        <field name="res_model">nomina.nomina</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================= -->
    <!-- MENÚ PRINCIPAL -->
    <!-- ============================= -->
    <menuitem id="menu_time_nomina_root"
        name="TimeNomina"
        sequence="10" />

    <!-- SUBMENÚ -->
    <menuitem id="menu_nomina"
        name="Nóminas"
        parent="menu_time_nomina_root"
        action="action_nomina"
        sequence="1" />

    <!-- ============================= -->
    <!-- ACCIÓN FICHAJES IRREGULARES -->
    <!-- ============================= -->
    <record id="action_fichajes_irregulares" model="ir.actions.act_window">
        <field name="name">Fichajes Irregulares</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            ['|', ('es_anomalia','=',True), ('pendiente_confirmacion','=',True)]
        </field>
    </record>

    <!-- SUBMENÚ FICHAJES IRREGULARES -->
    <menuitem
        id="menu_fichajes_irregulares"
        name="Fichajes Irregulares"
        parent="menu_time_nomina_root"
        action="action_fichajes_irregulares"
        sequence="2"
    />

</odoo>