<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_generar_nomina_wizard_form" model="ir.ui.view">
        <field name="name">generar.nomina.wizard.form</field>
        <field name="model">generar.nomina.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Nómina">
                <group>
                    <field name="empleado_id" />
                    <field name="mes" />
                    <field name="anio" />
                </group>
                <footer>
                    <button string="Generar"
                        type="object"
                        name="action_generar_nomina"
                        class="btn-primary" />
                    <button string="Cancelar"
                        special="cancel"
                        class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generar_nomina_wizard" model="ir.actions.act_window">
        <field name="name">Generar Nómina</field>
        <field name="res_model">generar.nomina.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>